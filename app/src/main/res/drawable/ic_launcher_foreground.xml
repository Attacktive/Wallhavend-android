<?xml version="1.0" encoding="utf-8"?>
<vector
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:width="108dp"
	android:height="108dp"
	android:viewportWidth="108"
	android:viewportHeight="108"
>
	<!-- Hexagonal Border (kept large for visual weight) -->
	<path
		android:pathData="M54,26 L78.25,40 L78.25,68 L54,82 L29.75,68 L29.75,40 Z"
		android:strokeWidth="2"
		android:strokeColor="#80FFFFFF"
	/>

	<!-- Scaled Group for the "W" and its glow to add padding INSIDE the hexagon -->
	<!-- Scaling the W down slightly (0.8 scale) while keeping it centered at 54,54 -->
	<group
		android:pivotX="54"
		android:pivotY="54"
		android:scaleX="0.8"
		android:scaleY="0.8"
	>
		<!-- Subtle Green Glow behind the W -->
		<path
			android:pathData="M34,42 L44,66 L54,42 L64,66 L74,42"
			android:strokeWidth="12"
			android:strokeColor="#2075A444"
			android:strokeLineCap="round"
			android:strokeLineJoin="round"
		/>

		<!-- Stylized W (Wallhaven Logo) -->
		<path
			android:pathData="M34,42 L44,66 L54,42 L64,66 L74,42"
			android:strokeWidth="6"
			android:strokeColor="#FFFFFF"
			android:strokeLineCap="round"
			android:strokeLineJoin="round"
		/>
	</group>
</vector>
